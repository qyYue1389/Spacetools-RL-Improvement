From cb846e1675bf32f8a9a763fe2294bfebe284ff8f Mon Sep 17 00:00:00 2001
From: SpaceTools Repro <qyYue1389@users.noreply.github.com>
Date: Tue, 25 Aug 2026 06:46:21 +0000
Subject: [PATCH] build: drop pickle5, which cannot compile on Python 3.11

pickle5 backports pickle protocol 5 to Python 3.6/3.7. Protocol 5 has been in
the standard library since 3.8, and the private C API the backport relies on
(_PyObject_CallNoArg, _PySys_GetObjectId, Py_SIZE as an lvalue) was removed in
3.11, so it cannot build at all:

    pickle5/_pickle.c: error: lvalue required as left operand of assignment

Removing it is behaviour-preserving: the only import site guards it already.

    try:
        import pickle5 as pickle
    except:
        import pickle

NOTE: the torch, torchvision, numpy and spconv changes in this diff are NOT
ours. install_graspgen.sh applies them itself via sed on every run, to move off
torch 2.1 (which cannot interoperate with numpy 2.x) and onto the cu121 spconv
build. They are committed here only so the working tree is clean.
---
 pyproject.toml   | 9 ++++-----
 requirements.txt | 1 -
 2 files changed, 4 insertions(+), 6 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 4dc8cca..30311e0 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -26,8 +26,8 @@ classifiers = [
 
 dependencies = [
     # Core PyTorch dependencies with CUDA support
-    "torch==2.1.0",
-    "torchvision==0.16.0", 
+    "torch>=2.3.0,<2.4",
+    "torchvision>=0.18.0,<0.19", 
     
     # PyTorch Geometric dependencies (installed from PyG wheel index)  
     "torch-cluster",
@@ -35,12 +35,11 @@ dependencies = [
     "torch-geometric",
     
     # Core dependencies from requirements.txt
-    "pickle5",
     "h5py",
     "hydra-core", 
     "matplotlib",
     "meshcat",
-    "numpy==1.26.4",
+    "numpy>=2.0",
     "webdataset",
     "scikit-learn",
     "scipy",
@@ -53,7 +52,7 @@ dependencies = [
     "huggingface-hub==0.25.2",
     "PyOpenGL==3.1.0",
     "addict",
-    "spconv-cu120",
+    "spconv-cu121",
     "yapf==0.40.1",
     "tensorboardx", 
     "sharedarray",
diff --git a/requirements.txt b/requirements.txt
index e595d76..2c69c49 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -1,4 +1,3 @@
-pickle5
 h5py
 hydra-core
 matplotlib
-- 
2.43.0

