+    # 默认 max_workers=8 实测只有 0.8 MB/s(7463 个文件,卡在每文件延迟上)。
+    # 实测 32 worker 写网络卷 30 MB/s、22.6 文件/s。纯下载并发,内容由哈希校验,零影响。
+    max_workers=32,
 )
 for subdir in ["data", "images"]:
     src = os.path.join(sft_path, subdir)
