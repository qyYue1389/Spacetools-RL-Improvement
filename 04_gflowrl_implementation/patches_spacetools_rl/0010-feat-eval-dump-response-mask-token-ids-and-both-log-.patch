+                        print(f"Warning: token_diag['{k}'] has {len(v)} entries, expected {n}; skipped")
+        except Exception as e:
+            print(f"Warning: could not dump token diagnostics: {e}")
+
         for k, v in reward_extra_infos_dict.items():
             if len(v) == n:
                 base_data[k] = v
@@ -559,6 +688,8 @@ class RayPPOTrainer:
         sample_scores = []
         sample_turns = []
         sample_uids = []
+        # P7 per-token diagnostics, keyed by the field name they get in the dump.
+        token_diag = defaultdict(list)
         sample_messages = []  # Collect messages for multimodal logging
         sample_multi_modal_data = []  # Collect multi_modal_data for image saving
 
@@ -673,6 +804,22 @@ class RayPPOTrainer:
 
             data_source_lst.append(test_batch.non_tensor_batch.get("data_source", ["unknown"] * reward_tensor.shape[0]))
 
+            # ---------------------------------------------------------------
+            # P7: per-token diagnostics.  See records/P7_GPU_HANDOFF.md §2.
+            #
+            # Everything here is diagnostics and is wrapped so that it can never
+            # break an eval -- same contract as the uid/num_turns fields above.
+            # ---------------------------------------------------------------
+            # Two ways to switch it on: the hydra key, or an env var as a fallback
+            # in case `+trainer.dump_token_diagnostics=True` trips over struct mode.
+            want_diag = os.environ.get("VERL_DUMP_TOKEN_DIAGNOSTICS", "").lower() in ("1", "true", "yes")
+            try:
+                want_diag = want_diag or bool(self.config.trainer.get("dump_token_diagnostics", False))
+            except Exception:
+                pass
+            if want_diag:
+                self._collect_token_diagnostics(test_batch, token_diag)
+
         self._maybe_log_val_generations(inputs=sample_inputs, outputs=sample_outputs, scores=sample_scores)
 
         # dump generations
@@ -689,6 +836,7 @@ class RayPPOTrainer:
                 multi_modal_data=sample_multi_modal_data if sample_multi_modal_data else None,
                 turns=sample_turns if sample_turns else None,
                 uids=sample_uids if sample_uids else None,
+                token_diag=dict(token_diag) if token_diag else None,
             )
 
         for key_info, lst in reward_extra_infos_dict.items():
