 verl/trainer/ppo/ray_trainer.py | 117 +++++++++++++++++++++++++++++++-
 2 files changed, 173 insertions(+), 1 deletion(-)

diff --git a/verl/trainer/ppo/core_algos.py b/verl/trainer/ppo/core_algos.py
index a78bd400..8a5ea211 100644
--- a/verl/trainer/ppo/core_algos.py
+++ b/verl/trainer/ppo/core_algos.py
@@ -2233,6 +2233,63 @@ def compute_policy_loss_reinforce(
     return pg_loss, pg_metrics
 
 
+@register_policy_loss("gflowrl")
+def compute_policy_loss_gflowrl(
+    old_log_prob: torch.Tensor,
+    log_prob: torch.Tensor,
+    advantages: torch.Tensor,
+    response_mask: torch.Tensor,
+    loss_agg_mode: str = "token-mean",
+    config: Optional[ActorConfig] = None,
+    rollout_is_weights: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, dict[str, Any]]:
+    """GFlowRL (arXiv:2607.13394) Eq. 8 -- the gradient-carrying half.
+
+        L = (1/G) sum_i  w_i * ( g~_i + [log pi_theta(y_i|x) - log pi_old(y_i|x)] )^2
+        w_i = min( pi_theta(y_i|x) / pi_old(y_i|x), 1 + eps )
+
+    `g~_i` (Eq. 4/6/7) is frozen w.r.t. theta, so it is computed once per step on the
+    driver and arrives here broadcast over the response inside `advantages`.
+    See ray_trainer.compute_gflowrl_flow_gap.
+
+    C-prime variant: the policy-update term is a SEQUENCE SUM (masked_sum), not a
+    per-token mean.  That is the whole difference from the published loss, and it is
+    deliberate -- records/P7_ROUTE_C_GATE.md.  Using masked_mean here would silently
+    turn this into the "normalized" configuration.
+
+    `loss_agg_mode` is ignored: Eq. 8 is a mean over sequences by construction.
+    """
+    eps_is = 0.2
+    if config is not None and hasattr(config, "policy_loss"):
+        _pl = config.policy_loss
+        _cfg = (_pl.get("gflowrl", {}) if hasattr(_pl, "get") else {}) or {}
+        eps_is = float(_cfg.get("eps_is", 0.2))
+
+    # recover the per-sequence g~ that the driver broadcast over the response
+    denom = response_mask.sum(dim=-1).clamp(min=1)
+    g_tilde = (advantages * response_mask).sum(dim=-1) / denom
+
+    # C-prime: sequence SUM, not masked_mean
+    log_ratio = verl_F.masked_sum(log_prob - old_log_prob, response_mask, axis=-1)
+
+    delta = g_tilde + log_ratio
+    # importance-sampling weight, stop-gradient (it corrects the sampler, it is not
+    # part of the objective being differentiated)
+    w = torch.clamp(torch.exp(log_ratio.detach()), max=1.0 + eps_is)
+
+    pg_loss = (w * delta.pow(2)).mean()
+
+    metrics = {
+        "gflowrl/loss": pg_loss.detach().item(),
+        "gflowrl/delta_abs_mean": delta.detach().abs().mean().item(),
+        "gflowrl/log_ratio_abs_mean": log_ratio.detach().abs().mean().item(),
+        "gflowrl/is_weight_mean": w.mean().item(),
+        "gflowrl/is_weight_clipped_frac": (w >= 1.0 + eps_is).float().mean().item(),
+        "actor/ppo_kl": (-log_ratio.detach().mean() / denom.float().mean()).item(),
+    }
+    return pg_loss, metrics
+
+
 @register_policy_loss("bypass_mode")
 def compute_policy_loss_bypass_mode(
     old_log_prob: torch.Tensor,
