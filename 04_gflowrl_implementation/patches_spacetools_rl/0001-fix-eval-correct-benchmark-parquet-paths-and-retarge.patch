-#   NUM_GPUS          — total GPUs (default: 8)
-#   EVAL_GPUS         — GPUs for eval inference (default: 4)
+#   NUM_GPUS          — total GPUs (default: 4)
+#   EVAL_GPUS         — GPUs for eval inference (default: 2)
 #
 # Usage:
 #   ROBOREFER_MODEL=/path/to/model DEPTH_CHECKPOINT=/path/to/depth_pro.pt \
@@ -47,8 +47,8 @@ VERL_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
 REPO_DIR="$(cd "$VERL_DIR/.." && pwd)"
 
 VERSION="${VERSION:-v1}"
-NUM_GPUS="${NUM_GPUS:-8}"
-EVAL_GPUS="${EVAL_GPUS:-4}"
+NUM_GPUS="${NUM_GPUS:-4}"
+EVAL_GPUS="${EVAL_GPUS:-2}"
 
