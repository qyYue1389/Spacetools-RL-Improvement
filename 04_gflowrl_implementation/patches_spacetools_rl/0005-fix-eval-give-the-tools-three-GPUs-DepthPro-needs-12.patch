 #   ROBOREFER_MODEL=/path/to/model DEPTH_CHECKPOINT=/path/to/depth_pro.pt \
@@ -67,7 +67,7 @@ REPO_DIR="$(cd "$VERL_DIR/.." && pwd)"
 
 VERSION="${VERSION:-v1}"
 NUM_GPUS="${NUM_GPUS:-4}"
-EVAL_GPUS="${EVAL_GPUS:-2}"
+EVAL_GPUS="${EVAL_GPUS:-1}"
 
 if [[ "$VERSION" == "v1" ]]; then
     TOOL_CONFIG="$SCRIPT_DIR/toolshed_v1_config.yaml"
@@ -103,6 +103,8 @@ echo "=== Downloading eval benchmarks ==="
