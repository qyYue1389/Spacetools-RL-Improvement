+def select_nondegenerate_groups(data: DataProto, pad_multiple: int) -> tuple[DataProto, dict]:
+    """Infra: drop reward-degenerate groups BEFORE old_log_prob / ref / update_actor.
+
+    Only meaningful together with gflowrl.filter_degenerate=True (P1-a), under which every
+    row of a degenerate group has g~ = 0 and, on-policy, contributes exactly zero gradient.
+    Removing those rows therefore does not change the update:
+
+      * dp_actor scales each micro-batch loss by 1 / gradient_accumulation, where
+        gradient_accumulation = ppo_mini_batch_size / micro_batch_size comes from the CONFIG
+        (80 / 2 per GPU here), not from the rows actually present.  Summed over micro-batches
+        that is  sum_over_local_rows(seq_loss) / 80, i.e. the denominator stays the full batch
+        -- the same as P1-a's "loss mask with every row kept in the denominator".
+      * FSDP averages gradients over ranks, so the global gradient is  sum_all(seq_loss) / 320
+        either way.
+
+    Two constraints keep that exact:
+      * the kept count is padded to a multiple of dp_size * micro_batch_size, so every rank
+        gets the same number of rows (balance_batch needs equal_size) and no micro-batch is
+        short (a 1-row micro-batch would still be scaled by 2/80 and count double);
+      * padding uses degenerate rows (shortest first, to spend the least compute on them);
+        with the filter on they carry g~ = 0 and add nothing.
+
+    Whole groups are kept, so Z_t (Eq. 4) of every kept group is unchanged.
+    """
+    r = data.batch["rm_scores"].sum(dim=-1).float().cpu()
+    uid = np.asarray(data.non_tensor_batch["uid"])
+    _, gidx_np = np.unique(uid, return_inverse=True)
+    gidx = torch.as_tensor(gidx_np, dtype=torch.long)
+    n_groups = int(gidx.max().item()) + 1
+    gmax = torch.full((n_groups,), float("-inf"), dtype=r.dtype).scatter_reduce(0, gidx, r, reduce="amax")
+    gmin = torch.full((n_groups,), float("inf"), dtype=r.dtype).scatter_reduce(0, gidx, r, reduce="amin")
+    degen = ((gmax - gmin) == 0)[gidx].numpy()
